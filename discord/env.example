# discord.com/developers/applications → your app

# General Information → Application ID  (NOT the Public Key — ignore the public key)
DISCORD_CLIENT_ID=

# Bot → Reset Token  (a long string; this is not the application id)
DISCORD_TOKEN=

# Discord app, Developer Mode on → right-click the server name → Copy Server ID
DISCORD_GUILD_ID=

# Make this up. Long random string. Send this to Grok later, never the token.
ADMIN_SECRET=
ADMIN_PORT=8787
