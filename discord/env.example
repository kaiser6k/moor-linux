# Create an application at https://discord.com/developers/applications
# Bot → Reset Token. Invite with applications.commands + bot, Administrator.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Shared secret so Grok (or you) can hit the admin HTTP API.
# Send Grok the public URL + this secret when you want the bot managed from chat.
ADMIN_SECRET=
ADMIN_PORT=8787
