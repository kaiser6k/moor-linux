# Copy to `.env` in the project root:
#   cp env.example .env
#
# Moor is a local desktop. Keep Grok/platform sign-in off unless you
# are wiring your own auth broker.
VITE_AUTH_ENABLED=false

# Optional Postgres (Neon, RDS, …). Leave unset to use the built-in
# on-device store. The desktop session itself lives in IndexedDB.
# DATABASE_URL=postgres://user:pass@host:5432/moor
